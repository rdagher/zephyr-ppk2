/*
 * nRF54LM20DK phase-profiling pins — the adjacent P1.12..P1.15 run on
 * the GPIO_P1 header: cycle D0 = P1.12, wakeup D1 = P1.13 (both
 * bench-proven by ppk2-lib's trace-demo), measure D2 = P1.14,
 * transmit D3 = P1.15 (unclaimed by any board peripheral).
 */
/ {
	zephyr,user {
		ppk2-d0-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		ppk2-d1-gpios = <&gpio1 13 GPIO_ACTIVE_HIGH>;
		ppk2-d2-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		ppk2-d3-gpios = <&gpio1 15 GPIO_ACTIVE_HIGH>;
	};
};
